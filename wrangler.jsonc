{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "stagelight",
  "compatibility_date": "2026-07-01",
  // Pure static SPA — no Worker script, no server-side audio handling.
  // The mp3 never leaves the browser.
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  }
}
